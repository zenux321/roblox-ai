{
  "name": "rab-desktop-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Interfața React a Roblox AI Builder (Tauri 2)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
