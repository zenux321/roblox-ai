{
  "schema_version": "0.2",
  "example_only": true,
  "collaboration": {
    "enabled": false,
    "mode": "solo",
    "transport": "https_and_websocket_tls",
    "host_bind_ip": null,
    "host_port": null,
    "allow_wildcard_bind": false,
    "require_host_fingerprint_verification": true,
    "require_host_acceptance": true,
    "pairing_code_ttl_seconds": 300,
    "pairing_max_attempts": 5,
    "shared_project_roots": [],
    "shared_vault_paths": [],
