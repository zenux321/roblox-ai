{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentsConfig",
  "type": "object",
  "properties": {
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentConfig"
      }
    },
    "budget": {
      "$ref": "#/$defs/BudgetConfig"
    },
    "example_only": {
      "type": "boolean"
    },
    "integrations": {
      "$ref": "#/$defs/IntegrationsConfig"
    },
    "policy": {
      "$ref": "#/$defs/PolicyConfig"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "providers": {
      "$ref": "#/$defs/ProvidersConfig"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeConfig"
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_only",
    "project",
    "runtime",
    "budget",
    "providers",
    "policy",
    "agents",
    "integrations"
  ],
  "$defs": {
    "AgentConfig": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/AgentRole"
        },
        "output_contract": {
          "$ref": "#/$defs/OutputContract"
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolId"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "tools",
        "output_contract"
      ]
    },
    "AgentRole": {
      "type": "string",
      "enum": [
        "planner",
        "researcher",
        "builder",
        "reviewer",
        "memory_curator"
      ]
    },
    "ApiProviderConfig": {
      "type": "object",
      "properties": {
        "credential_ref": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "credential_ref"
      ]
    },
    "BudgetConfig": {
      "type": "object",
      "properties": {
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "max_month_usd": {
          "type": "number",
          "format": "double"
        },
        "max_run_usd": {
          "type": "number",
          "format": "double"
        },
        "paid_fallback": {
          "type": "boolean"
        },
        "reserve_before_request": {
          "type": "boolean"
        },
        "unknown_price_action": {
          "$ref": "#/$defs/UnknownPriceAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "currency",
        "max_run_usd",
        "max_month_usd",
        "reserve_before_request",
        "unknown_price_action",
        "paid_fallback"
      ]
    },
    "ClaudeCodeConfig": {
      "type": "object",
      "properties": {
        "embedded_provider_enabled": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/$defs/ClaudeCodeMode"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode",
        "embedded_provider_enabled"
      ]
    },
    "ClaudeCodeMode": {
      "type": "string",
      "enum": [
        "external_development_tool_only"
      ]
    },
    "Currency": {
      "type": "string",
      "enum": [
        "USD"
      ]
    },
    "GithubAuth": {
      "type": "string",
      "enum": [
        "git_credential_manager"
      ]
    },
    "GithubConfig": {
      "type": "object",
      "properties": {
        "auth": {
          "$ref": "#/$defs/GithubAuth"
        },
        "enabled": {
          "type": "boolean"
        },
        "private_by_default": {
          "type": "boolean"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "auth",
        "private_by_default"
      ]
    },
    "ImageQuality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "IntegrationsConfig": {
      "type": "object",
      "properties": {
        "claude_code": {
          "$ref": "#/$defs/ClaudeCodeConfig"
        },
        "github": {
          "$ref": "#/$defs/GithubConfig"
        },
        "roblox_studio_mcp": {
          "$ref": "#/$defs/StudioMcpConfig"
        },
        "rojo": {
          "$ref": "#/$defs/RojoConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "roblox_studio_mcp",
        "rojo",
        "github",
        "claude_code"
      ]
    },
    "IpcTransport": {
      "type": "string",
      "enum": [
        "windows_named_pipe"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio"
      ]
    },
    "NetworkDefault": {
      "type": "string",
      "enum": [
        "deny"
      ]
    },
    "OllamaConfig": {
      "type": "object",
      "properties": {
        "allow_cloud_models": {
          "type": "boolean"
        },
        "context_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "max_output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpoint",
        "model",
        "allow_cloud_models",
        "context_tokens",
        "max_output_tokens"
      ]
    },
    "OpenAiImagesConfig": {
      "type": "object",
      "properties": {
        "credential_ref": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_images_per_run": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "$ref": "#/$defs/ImageQuality"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "credential_ref",
        "max_images_per_run",
        "quality"
      ]
    },
    "OutputContract": {
      "type": "string",
      "enum": [
        "plan_proposal",
        "sourced_notes",
        "patch_proposal",
        "review_report",
        "note_proposal"
      ]
    },
    "PolicyConfig": {
      "type": "object",
      "properties": {
        "allow_arbitrary_host_code": {
          "type": "boolean"
        },
        "allow_arbitrary_shell": {
          "type": "boolean"
        },
        "allow_git_push": {
          "type": "boolean"
        },
        "allow_github_pr": {
          "type": "boolean"
        },
        "allow_paid_calls": {
          "type": "boolean"
        },
        "allow_publish": {
          "type": "boolean"
        },
        "allow_unrestricted_luau": {
          "type": "boolean"
        },
        "allow_upload": {
          "type": "boolean"
        },
        "invalidate_approval_on_plan_change": {
          "type": "boolean"
        },
        "network_default": {
          "$ref": "#/$defs/NetworkDefault"
        },
        "reject_external_private_network_targets": {
          "type": "boolean"
        },
        "require_approved_plan": {
          "type": "boolean"
        },
        "require_plan_for_network": {
          "type": "boolean"
        },
        "research_allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets_in_model_context": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "require_approved_plan",
        "invalidate_approval_on_plan_change",
        "allow_arbitrary_shell",
        "allow_arbitrary_host_code",
        "allow_unrestricted_luau",
        "allow_paid_calls",
        "allow_upload",
        "allow_publish",
        "allow_git_push",
        "allow_github_pr",
        "network_default",
        "research_allowed_hosts",
        "require_plan_for_network",
        "reject_external_private_network_targets",
        "secrets_in_model_context"
      ]
    },
    "ProjectConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "personal_notes_read_only": {
          "type": "boolean"
        },
        "root": {
          "type": "string"
        },
        "vault_root": {
          "type": "string"
        },
        "vault_write_subdirectory": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "root",
        "vault_root",
        "vault_write_subdirectory",
        "personal_notes_read_only"
      ]
    },
    "ProviderId": {
      "type": "string",
      "enum": [
        "ollama",
        "anthropic_api",
        "openai_images"
      ]
    },
    "ProvidersConfig": {
      "type": "object",
      "properties": {
        "anthropic_api": {
          "$ref": "#/$defs/ApiProviderConfig"
        },
        "ollama": {
          "$ref": "#/$defs/OllamaConfig"
        },
        "openai_images": {
          "$ref": "#/$defs/OpenAiImagesConfig"
        }
      },
      "additionalProperties": false,
      "required": [
        "ollama",
        "anthropic_api",
        "openai_images"
      ]
    },
    "RojoConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "filesystem_owned_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_file": {
          "type": "string"
        },
        "require_backup_before_first_sync": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "project_file",
        "filesystem_owned_paths",
        "require_backup_before_first_sync"
      ]
    },
    "RuntimeConfig": {
      "type": "object",
      "properties": {
        "background_worker": {
          "type": "boolean"
        },
        "ipc_transport": {
          "$ref": "#/$defs/IpcTransport"
        },
        "max_agent_steps_per_task": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_concurrent_tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_tool_output_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "start_at_logon": {
          "type": "boolean"
        },
        "task_timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "max_concurrent_tasks",
        "max_agent_steps_per_task",
        "max_retries",
        "task_timeout_seconds",
        "max_tool_output_bytes",
        "background_worker",
        "start_at_logon",
        "ipc_transport"
      ]
    },
    "StudioConfigurationSource": {
      "type": "string",
      "enum": [
        "studio_official_setup"
      ]
    },
    "StudioMcpConfig": {
      "type": "object",
      "properties": {
        "configuration_source": {
          "$ref": "#/$defs/StudioConfigurationSource"
        },
        "enabled": {
          "type": "boolean"
        },
        "require_capability_discovery": {
          "type": "boolean"
        },
        "studio_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport": {
          "$ref": "#/$defs/McpTransport"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "transport",
        "configuration_source",
        "require_capability_discovery"
      ]
    },
    "ToolId": {
      "description": "Instrumentele cunoscute de policy engine. Un nume necunoscut este respins la parsare.",
      "type": "string",
      "enum": [
        "memory.search",
        "memory.propose_note",
        "project.read",
        "project.propose_patch",
        "project.apply_validated_patch",
        "research.fetch",
        "tests.read_results",
        "tests.static_luau",
        "reports.write",
        "git.push",
        "github.create_pr",
        "roblox.upload_asset",
        "roblox.publish"
      ]
    },
    "UnknownPriceAction": {
      "type": "string",
      "enum": [
        "deny"
      ]
    }
  }
}
